<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <Definition xsi:type="MyObjectBuilder_WeaponBlockDefinition">
      <Id>
        <TypeId>SmallMissileLauncher</TypeId>
        <SubtypeId>LauncherX</SubtypeId>
      </Id>
      <DisplayName>Launcher X</DisplayName>
      <Icon>Textures\GUI\Icons\LauncherX.dds</Icon>
      <Description>Torre lança-mísseis vertical (1x1x4). Portas abrem com o bloco ligado e fecham desligado ou danificado. Munição pelo transportador na base.</Description>
      <CubeSize>Large</CubeSize>
      <GuiVisible>true</GuiVisible>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="4" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\LauncherX\LauncherX.mwm</Model>
      <Components>
        <Component Subtype="SteelPlate" Count="80" />
        <Component Subtype="Construction" Count="40" />
        <Component Subtype="MetalGrid" Count="60" />
        <Component Subtype="LargeTube" Count="40" />
        <Component Subtype="Motor" Count="16" />
        <Component Subtype="Computer" Count="12" />
        <Component Subtype="SteelPlate" Count="40" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="1" EndY="1" Default="true" />
      </MountPoints>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>90</BuildTimeSeconds>
      <EdgeType>Light</EdgeType>
      <WeaponDefinitionId Subtype="LauncherX_Weapon" />
      <ResourceSinkGroup>Defense</ResourceSinkGroup>
      <InventoryMaxVolume>4</InventoryMaxVolume>
      <DamageEffectName>Damage_WeapExpl_Damaged</DamageEffectName>
      <DamagedSound>ParticleWeapExpl</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>1500</PCU>
      <TargetingGroups>
        <string>Weapons</string>
      </TargetingGroups>
    </Definition>
  </CubeBlocks>

  <Ammos>
    <Ammo xsi:type="MyObjectBuilder_MissileAmmoDefinition">
      <Id>
        <TypeId>AmmoDefinition</TypeId>
        <SubtypeId>LauncherXMissile</SubtypeId>
      </Id>
      <BasicProperties>
        <DesiredSpeed>300</DesiredSpeed>
        <SpeedVariance>0</SpeedVariance>
        <MaxTrajectory>3000</MaxTrajectory>
        <IsExplosive>true</IsExplosive>
        <BackkickForce>0</BackkickForce>
        <PhysicalMaterial>Missile</PhysicalMaterial>
        <ExplosiveDamageMultiplier>2</ExplosiveDamageMultiplier>
        <DeathMessage>CauseOfDeath_HeavyWeapons</DeathMessage>
      </BasicProperties>
      <MissileProperties>
        <MissileMass>300</MissileMass>
        <MissileExplosionRadius>11</MissileExplosionRadius>
        <MissileModelName>Models\LauncherX\LauncherX_Missile.mwm</MissileModelName>
        <MissileAcceleration>30</MissileAcceleration>
        <MissileInitialSpeed>3</MissileInitialSpeed>
        <MissileSkipAcceleration>false</MissileSkipAcceleration>
        <MissileExplosionDamage>10000</MissileExplosionDamage>
        <MissileTrailEffect></MissileTrailEffect>
      </MissileProperties>
    </Ammo>
  </Ammos>

  <AmmoMagazines>
    <AmmoMagazine>
      <Id>
        <TypeId>AmmoMagazine</TypeId>
        <SubtypeId>LauncherXMissile</SubtypeId>
      </Id>
      <DisplayName>Míssil Launcher X</DisplayName>
      <Icon>Textures\GUI\Icons\ammo\Small_Rocket.dds</Icon>
      <Size>
        <X>0.25</X>
        <Y>0.2</Y>
        <Z>0.2</Z>
      </Size>
      <Mass>300</Mass>
      <Volume>400</Volume>
      <Model>Models\LauncherX\LauncherX_Display.mwm</Model>
      <PhysicalMaterial>Ammo</PhysicalMaterial>
      <Capacity>1</Capacity>
      <AmmoDefinitionId Subtype="LauncherXMissile" />
    </AmmoMagazine>
  </AmmoMagazines>

  <Weapons>
    <Weapon>
      <Id>
        <TypeId>WeaponDefinition</TypeId>
        <SubtypeId>LauncherX_Weapon</SubtypeId>
      </Id>
      <MissileAmmoData RateOfFire="60" ShootSoundName="WepShipSmallMissileShot" FlightSoundName="MissileFlightSound" ShotsInBurst="1" />
      <DeviateShotAngle>0</DeviateShotAngle>
      <DeviateShotAngleAiming>0</DeviateShotAngleAiming>
      <NoAmmoSoundName>WepShipGatlingNoAmmo</NoAmmoSoundName>
      <AmmoMagazines>
        <AmmoMagazine Subtype="LauncherXMissile" />
      </AmmoMagazines>
      <ReloadTime>6000</ReloadTime>
    </Weapon>
  </Weapons>

  <Blueprints>
    <Blueprint>
      <Id>
        <TypeId>BlueprintDefinition</TypeId>
        <SubtypeId>LauncherXMissile</SubtypeId>
      </Id>
      <DisplayName>Míssil Launcher X</DisplayName>
      <Icon>Textures\GUI\Icons\ammo\Small_Rocket.dds</Icon>
      <Prerequisites>
        <Item Amount="300" TypeId="Ingot" SubtypeId="Iron" />
        <Item Amount="40" TypeId="Ingot" SubtypeId="Nickel" />
        <Item Amount="2" TypeId="Ingot" SubtypeId="Silicon" />
        <Item Amount="0.5" TypeId="Ingot" SubtypeId="Uranium" />
        <Item Amount="0.2" TypeId="Ingot" SubtypeId="Platinum" />
        <Item Amount="10" TypeId="Ingot" SubtypeId="Magnesium" />
      </Prerequisites>
      <Result Amount="1" TypeId="AmmoMagazine" SubtypeId="LauncherXMissile" />
      <BaseProductionTimeInSeconds>30</BaseProductionTimeInSeconds>
    </Blueprint>
  </Blueprints>

  <BlueprintClassEntries>
    <Entry Class="Ammo" BlueprintSubtypeId="LauncherXMissile" />
  </BlueprintClassEntries>
</Definitions>
